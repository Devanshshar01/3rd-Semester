# Clerk Dashboard: create an application and enable your preferred sign-in methods
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# PostgreSQL connection string for a database you control
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# LiveKit Cloud or self-hosted server credentials (server-only secret)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

PORT=3000
NODE_ENV=development
