# Local development: use the Clerk Development instance and test keys.
# In Vercel Production, use matching pk_live_... / sk_live_... keys.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Optional server proxy override; leave unset locally. Production defaults to:
# https://studywithatea.vercel.app/__clerk
# CLERK_PROXY_URL=https://studywithatea.vercel.app/__clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Optional browser proxy override; leave unset locally. Production defaults to
# the deployed origin plus /__clerk.
# VITE_CLERK_PROXY_URL=https://studywithatea.vercel.app/__clerk
# Optional: set to true only while diagnosing middleware/proxy requests.
CLERK_DEBUG=false

# PostgreSQL connection string for a database you control
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# LiveKit Cloud or self-hosted server credentials (server-only secret)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

PORT=3000
NODE_ENV=development
